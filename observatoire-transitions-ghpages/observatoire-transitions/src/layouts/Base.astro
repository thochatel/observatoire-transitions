---
import { SITE_NAME, SITE_DESCRIPTION, url } from '../site';
const { title = SITE_NAME, description = SITE_DESCRIPTION } = Astro.props;
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f8f5" />
    <title>{title}</title>
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" type="image/svg+xml" href={url("/favicon.svg")} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={url("/")} aria-label={`Accueil ${SITE_NAME}`}>
        <span class="brand-mark">OT</span>
        <span>Observatoire <em>des transitions</em></span>
      </a>
      <nav aria-label="Navigation principale">
        <a href={url("/")}>Accueil</a>
        <a href={url("/veille/")}>La veille</a>
        <a href={url("/a-propos/")}>À propos</a>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <span>{SITE_NAME}</span>
      <span>Comprendre · Analyser · Agir</span>
    </footer>
  </body>
</html>
<style is:global>
  :root{font-family:system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:#202923;background:#f7f8f5;font-synthesis:none;text-rendering:optimizeLegibility}
  *{box-sizing:border-box}
  body{margin:0;line-height:1.65}
  a{color:inherit}
  .site-header{max-width:1120px;margin:auto;padding:24px 28px;display:flex;align-items:center;justify-content:space-between;gap:24px;border-bottom:1px solid #e2e7df}
  .brand{text-decoration:none;display:flex;align-items:center;gap:12px;font-weight:750;letter-spacing:-.03em}
  .brand em{font-style:normal;color:#54745e}
  .brand-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:12px;background:#244b38;color:white;font-size:13px;letter-spacing:0}
  nav{display:flex;gap:22px;font-size:14px}
  nav a{text-decoration:none;color:#59645d}
  nav a:hover,.text-link:hover{color:#17643d}
  main{min-height:70vh}
  .site-footer{max-width:1120px;margin:60px auto 0;padding:24px 28px 36px;border-top:1px solid #e2e7df;display:flex;justify-content:space-between;gap:20px;color:#68736b;font-size:13px}
  .container{max-width:1120px;margin:auto;padding:48px 28px}
  .eyebrow{text-transform:uppercase;letter-spacing:.12em;font-size:11px;font-weight:750;color:#5a7963}
  h1,h2,h3{line-height:1.15;letter-spacing:-.04em}
  h1{font-size:clamp(2.4rem,6vw,4.5rem);max-width:800px;margin:14px 0}
  h2{font-size:clamp(1.6rem,3vw,2.2rem)}
  p{color:#566159}
  .lead{font-size:1.15rem;max-width:680px}
  .button{display:inline-flex;padding:11px 17px;border-radius:7px;background:#244b38;color:white;text-decoration:none;font-weight:650;font-size:14px}
  .button:hover{background:#173a29}
  .grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}
  .card{background:#fff;border:1px solid #e4e9e2;border-radius:12px;padding:22px;display:flex;flex-direction:column;min-height:220px}
  .card h3{font-size:1.2rem;margin:12px 0 8px}
  .card h3 a{text-decoration:none}
  .card p{font-size:14px;margin:0 0 18px}
  .meta{font-size:11px;text-transform:uppercase;letter-spacing:.08em;color:#718076}
  .chips{display:flex;flex-wrap:wrap;gap:7px;margin-top:auto}
  .chip{font-size:11px;padding:4px 9px;border-radius:99px;background:#eef3ed;color:#42614b}
  .section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin:54px 0 20px}
  .text-link{font-size:14px;color:#42614b}
  .article{max-width:760px;margin:auto;padding:52px 28px}
  .article h1{font-size:clamp(2.2rem,5vw,3.6rem)}
  .article-content{margin-top:34px}
  .article-content h2{margin-top:2em}
  .article-content a{color:#236344}
  .cover,.article-content img{max-width:100%;height:auto;border-radius:10px}
  .cover{margin:18px 0 0}
  .source-box{padding:18px;background:#eef3ed;border-radius:10px;margin:28px 0}
  @media(max-width:760px){.site-header{align-items:flex-start;flex-direction:column}.grid{grid-template-columns:1fr}.container{padding:36px 20px}.site-footer{margin-top:36px;flex-direction:column}nav{gap:16px;flex-wrap:wrap}}
</style>

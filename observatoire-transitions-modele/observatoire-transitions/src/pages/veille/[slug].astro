---
import Base from '../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
export async function getStaticPaths() {
  const entries = await getCollection('veille', ({ data }) => !data.draft);
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
const date = new Intl.DateTimeFormat('fr-FR', { day:'numeric', month:'long', year:'numeric' }).format(entry.data.date);
---
<Base title={`${entry.data.title} – Observatoire des transitions`} description={entry.data.summary}>
  <article class="article">
    <a class="text-link" href="/veille/">← Retour à la veille</a>
    <div class="eyebrow" style="margin-top:32px">{entry.data.type} · {date}</div>
    <h1>{entry.data.title}</h1>
    <div class="chips">{entry.data.themes.map((theme) => <span class="chip">{theme}</span>)}</div>
    <p class="lead">{entry.data.summary}</p>
    <div class="article-content"><Content /></div>
    {(entry.data.source || entry.data.sourceUrl) && (
      <aside class="source-box">
        <strong>Source</strong>
        <p>{entry.data.source}</p>
        {entry.data.sourceUrl && <a href={entry.data.sourceUrl} target="_blank" rel="noopener noreferrer">Consulter la source originale ↗</a>}
      </aside>
    )}
  </article>
</Base>

---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
const entries = (await getCollection('veille', ({ data }) => !data.draft))
  .sort((a,b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = entries.find((entry) => entry.data.featured) ?? entries[0];
const latest = entries.filter((entry) => entry.id !== featured?.id).slice(0, 6);
const dateFmt = (date) => new Intl.DateTimeFormat('fr-FR', { day:'numeric', month:'long', year:'numeric' }).format(date);
---
<Base title="Observatoire des transitions" description="Une veille éditoriale sur le climat, les territoires, la biodiversité et le numérique responsable.">
  <section class="container">
    <div class="eyebrow">Veille · Ressources · Analyses</div>
    <h1>Comprendre les transitions.<br/><span style="color:#54745e">Éclairer l'action.</span></h1>
    <p class="lead">Un observatoire indépendant pour repérer, décrypter et partager les ressources utiles à la transition écologique.</p>
    <a class="button" href="/veille/">Explorer la veille <span aria-hidden="true">→</span></a>
    {featured && (
      <div style="margin-top:54px;padding:30px;border-radius:14px;background:#eaf0e9;max-width:850px">
        <div class="eyebrow">À la une · {dateFmt(featured.data.date)}</div>
        <h2 style="max-width:700px;margin:12px 0">{featured.data.title}</h2>
        <p>{featured.data.summary}</p>
        <a class="text-link" href={`/veille/${featured.id}/`}>Lire la publication →</a>
      </div>
    )}
    <div class="section-head">
      <div><div class="eyebrow">Dernières publications</div><h2 style="margin:8px 0 0">À explorer</h2></div>
      <a class="text-link" href="/veille/">Toute la veille →</a>
    </div>
    <div class="grid">
      {latest.map((entry) => (
        <article class="card">
          <div class="meta">{entry.data.type} · {dateFmt(entry.data.date)}</div>
          <h3><a href={`/veille/${entry.id}/`}>{entry.data.title}</a></h3>
          <p>{entry.data.summary}</p>
          <div class="chips">{entry.data.themes.slice(0,3).map((theme) => <span class="chip">{theme}</span>)}</div>
        </article>
      ))}
    </div>
  </section>
</Base>
